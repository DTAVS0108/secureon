# ---- Environment ----
SECUREONE_ENV=development
SPRING_PROFILES_ACTIVE=dev
SECUREONE_SWAGGER_ENABLED=true
SECUREONE_DEV_AUTH_ENABLED=true
SECUREONE_CORS_ALLOWED_ORIGINS=
SECUREONE_OTP_PEPPER=change-me-in-production

# ---- Database (PostgreSQL) ----
SECUREONE_DB_URL=jdbc:postgresql://localhost:5432/secureone
SECUREONE_DB_USERNAME=secureone
SECUREONE_DB_PASSWORD=change-me
# Optional: a separate user for database upgrades (may change tables); the user above then needs no DDL rights.
# SECUREONE_DB_MIGRATION_USERNAME=
# SECUREONE_DB_MIGRATION_PASSWORD=

# ---- Redis ----
SECUREONE_REDIS_URL=redis://localhost:6379

# ---- OIDC / JWT ----
SECUREONE_ISSUER_URL=http://localhost:9000
SECUREONE_JWT_KEY_SOURCE=local          # local | kms | vault
# Production: PEM-encoded PKCS#8 RSA private key (required when SECUREONE_ENV=production).
# Generate: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048. Blank (dev) = generated once,
# stored encrypted. One-line env files: use \n for line breaks.
SECUREONE_JWK_PRIVATE_KEY_PEM=
# During a key rotation only: the previous key (as it was configured). Its public part stays in JWKS so
# tokens signed before the switch remain valid; remove after the longest token lifetime. See runbooks/key-rotation.md
SECUREONE_JWK_PREVIOUS_PRIVATE_KEY_PEM=

# ---- Rate limiting (Redis-backed) ----
SECUREONE_RATE_LIMIT_ENABLED=true
SECUREONE_RATE_LIMIT_LOGIN_PER_MINUTE=20
SECUREONE_RATE_LIMIT_TOKEN_PER_MINUTE=60
SECUREONE_RATE_LIMIT_FORGOT_PASSWORD_PER_MINUTE=5
SECUREONE_RATE_LIMIT_OTP_REQUEST_PER_MINUTE=10
SECUREONE_RATE_LIMIT_ADMIN_LOGIN_PER_MINUTE=10

# ---- Secret encryption (stored secrets + generated signing keys) ----
# AES-256 key kept OUTSIDE the database: encrypts SMTP/SMS credentials, IdP client secrets and the
# JWT / SAML private keys SecureOne generates. Generate: echo "base64:$(openssl rand -base64 32)"
# Blank = development fallback (key stored in the database, warning at startup). A malformed value
# stops startup. Production: set it from your secret manager and back it up separately from the DB.
SECUREONE_ENCRYPTION_KEY=

# ---- SAML 2.0 SSO (optional) ----
# SP signing/decryption key (PKCS#8 PEM) + self-signed certificate published in SP metadata.
# Blank = generated on first SAML use and stored encrypted. One-line env files: use \n for line breaks.
SECUREONE_SAML_SP_KEY_PEM=
SECUREONE_SAML_SP_CERT_PEM=

# ---- Email (SMTP) ----
# Dev default: MailHog via docker compose (localhost:1025, UI http://localhost:8025).
# Most providers need an app password when the account uses two-step sign-in.
SECUREONE_SMTP_HOST=smtp.example.com
SECUREONE_SMTP_PORT=587
SECUREONE_SMTP_USERNAME=you@example.com
SECUREONE_SMTP_PASSWORD=your-app-password
SECUREONE_SMTP_AUTH=true
SECUREONE_SMTP_STARTTLS=true
SECUREONE_SMTP_SSL_TRUST=smtp.example.com
# Set false when using real SMTP so failures surface instead of logging to console
SECUREONE_MAIL_LOG_WHEN_UNAVAILABLE=true

# ---- Database upgrades and configuration files (docs/install/configuration-and-upgrades.md) ----
# auto (default): upgrade the database at start-up. only: upgrade, then exit (run before a rollout).
# validate: never change it; refuse to start while an upgrade is missing.
# SECUREONE_DB_MIGRATE=auto
# Tenant configuration files (a file or a folder of .yaml/.yml/.json) applied at every start-up.
# SECUREONE_CONFIG_IMPORT=/etc/secureone/config

# ---- First platform operator at the first start (like Keycloak's KC_BOOTSTRAP_ADMIN_*) ----
# Used once, when no platform operator exists; ignored afterwards. Prefer a secret file for the password:
# /run/secrets/SECUREONE_BOOTSTRAP_ADMIN_PASSWORD (any setting can be a file there; SECUREONE_SECRETS_DIR).
# SECUREONE_BOOTSTRAP_ADMIN_EMAIL=owner@example.com
# SECUREONE_BOOTSTRAP_ADMIN_PASSWORD=
# SECUREONE_BOOTSTRAP_ADMIN_FIRST_NAME=
# SECUREONE_BOOTSTRAP_ADMIN_LAST_NAME=

# ---- First-run setup ----
# Until a platform operator exists, the server prints a one-time setup code in its log; open
# <public URL>/admin/setup, enter it and create the first operator. For automated installs you can
# fix the code instead (keep it secret; it only works until setup is done):
# SECUREONE_SETUP_CODE=

# ---- Behind a reverse proxy that is NOT on a private network (e.g. a CDN) ----
# Regular expression of the proxy addresses whose X-Forwarded-* headers are trusted (client address, https).
# SERVER_TOMCAT_REMOTEIP_INTERNAL_PROXIES=203\.0\.113\.\d+

# All settings, required / production / optional: docs/install/deployment.md, "All settings".
