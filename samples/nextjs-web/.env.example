# Copy to .env.local and fill in. Never commit .env.local (it holds the client secret).
NEXTAUTH_URL=http://localhost:3000
# Any long random string: openssl rand -base64 32
NEXTAUTH_SECRET=
SECUREONE_ISSUER=http://localhost:9000
SECUREONE_CLIENT_ID=demo-store-web
# Shown once when the client is created (Connect an app); rotate it on the client page if lost.
SECUREONE_CLIENT_SECRET=
