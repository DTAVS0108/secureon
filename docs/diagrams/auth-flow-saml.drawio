        <mxCell id="s9" value="7. verify; end every session of the linked user" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="440" y="540" width="200" height="40" as="geometry" /></mxCell>
