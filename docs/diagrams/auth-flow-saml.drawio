        <mxCell id="s1" value="SP-initiated: the app signs the user out" style="text;html=1;align=left;fontStyle=3;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="840" height="24" as="geometry" /></mxCell>
        <mxCell id="s2" value="1. /connect/logout (id_token_hint, post_logout_redirect_uri)" style="html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="154" as="sourcePoint" /><mxPoint x="540" y="154" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="s3" value="2. SAML session → end local session" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="440" y="196" width="200" height="40" as="geometry" /></mxCell>
        <mxCell id="s4" value="3. signed LogoutRequest (NameID, SessionIndex)" style="html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="540" y="274" as="sourcePoint" /><mxPoint x="750" y="274" as="targetPoint" /></mxGeometry></mxCell>
