        <mxCell id="h_auth" value="auth-server&#10;(SAML SP)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="30" width="160" height="50" as="geometry" /></mxCell>
        <mxCell id="ll_auth" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="540" y="80" as="sourcePoint" /><mxPoint x="540" y="430" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="h_idp" value="Company IdP&#10;(any SAML 2.0 IdP)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="670" y="30" width="160" height="50" as="geometry" /></mxCell>
        <mxCell id="ll_idp" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="750" y="80" as="sourcePoint" /><mxPoint x="750" y="430" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="s1" value="1. open app tile in the IdP portal" style="html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="110" as="sourcePoint" /><mxPoint x="750" y="110" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="s2" value="2. POST /federation/saml/acs/{providerId} (no InResponseTo)" style="html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;endArrow=open;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="750" y="170" as="sourcePoint" /><mxPoint x="540" y="170" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="s3" value="3. provider allows IdP-initiated? signature, audience, replay cache" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="440" y="212" width="200" height="40" as="geometry" /></mxCell>
        <mxCell id="s4" value="4. sign in (same account rules)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="440" y="272" width="200" height="40" as="geometry" /></mxCell>
        <mxCell id="s5" value="5. 302 landingUrl (set by the operator)" style="html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;endArrow=open;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="540" y="350" as="sourcePoint" /><mxPoint x="330" y="350" as="targetPoint" /></mxGeometry></mxCell>
