        <mxCell id="s6" value="5. 302 post_logout_redirect_uri?state" style="html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;endArrow=open;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="540" y="394" as="sourcePoint" /><mxPoint x="330" y="394" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="s7" value="IdP-initiated: the user signed out at the IdP" style="text;html=1;align=left;fontStyle=3;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="840" height="24" as="geometry" /></mxCell>
