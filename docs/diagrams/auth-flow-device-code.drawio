<mxfile host="app.diagrams.net" type="device">
  <diagram id="device-code" name="Device authorization grant (RFC 8628)">
    <mxGraphModel dx="900" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="920" pageHeight="880" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="h_dev" value="Device&#10;(TV app / CLI)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="160" height="50" as="geometry" /></mxCell>
        <mxCell id="ll_dev" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="80" as="sourcePoint" /><mxPoint x="120" y="850" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="h_auth" value="auth-server" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="250" y="30" width="160" height="50" as="geometry" /></mxCell>
        <mxCell id="ll_auth" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="80" as="sourcePoint" /><mxPoint x="330" y="850" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="h_ph" value="User's phone / laptop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="30" width="160" height="50" as="geometry" /></mxCell>
        <mxCell id="ll_ph" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="540" y="80" as="sourcePoint" /><mxPoint x="540" y="850" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="h_page" value="/account/device.html&#10;+ hosted login" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="670" y="30" width="160" height="50" as="geometry" /></mxCell>
        <mxCell id="ll_page" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="750" y="80" as="sourcePoint" /><mxPoint x="750" y="850" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="s1" value="1. POST /oauth2/device_authorization (client_id, scope)" style="html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="110" as="sourcePoint" /><mxPoint x="330" y="110" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="s2" value="2. device_code, user_code, verification_uri(_complete), interval=5" style="html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;endArrow=open;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="170" as="sourcePoint" /><mxPoint x="120" y="170" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="s3" value="3. show code / QR; poll every 5 s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="20" y="212" width="200" height="40" as="geometry" /></mxCell>
        <mxCell id="s4" value="4. POST /oauth2/token (device_code) → authorization_pending | slow_down" style="html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="290" as="sourcePoint" /><mxPoint x="330" y="290" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="s5" value="5. open verification URI, enter code" style="html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="540" y="350" as="sourcePoint" /><mxPoint x="750" y="350" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="s6" value="6. POST /api/v1/auth/device/lookup → app name" style="html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="750" y="410" as="sourcePoint" /><mxPoint x="330" y="410" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="s7" value="7. GET /oauth2/device_verification (sign in first if needed)" style="html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="750" y="470" as="sourcePoint" /><mxPoint x="330" y="470" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="s8" value="8. tenant + app access check" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="230" y="512" width="200" height="40" as="geometry" /></mxCell>
        <mxCell id="s9" value="9. Allow / Deny (consent, POST with state)" style="html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;endArrow=open;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="590" as="sourcePoint" /><mxPoint x="750" y="590" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="s10" value="10. POST /oauth2/device_verification (Allow)" style="html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="750" y="650" as="sourcePoint" /><mxPoint x="330" y="650" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="s11" value="11. POST /oauth2/token (device_code)" style="html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="710" as="sourcePoint" /><mxPoint x="330" y="710" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="s12" value="12. access + refresh token (no ID token); code single use" style="html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;endArrow=open;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="770" as="sourcePoint" /><mxPoint x="120" y="770" as="targetPoint" /></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
