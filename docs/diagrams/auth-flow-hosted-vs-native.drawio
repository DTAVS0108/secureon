        <mxCell id="s9" value="8. POST /oauth2/token → tokens" style="html=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="574" as="sourcePoint" /><mxPoint x="540" y="574" as="targetPoint" /></mxGeometry></mxCell>
