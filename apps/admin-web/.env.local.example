# Copy to .env.local for `next dev` (port 3001). All values are read at runtime, never at build time,
# and use the auth-server's own variable names. The defaults below match the local dev stack.

# Public URL of the auth-server (shown in the console, used for links to hosted pages).
SECUREONE_PUBLIC_BASE_URL=http://localhost:9000
# Where the console's server calls the auth-server API (defaults to the public URL).
# SECUREONE_AUTH_SERVER_INTERNAL_URL=http://localhost:9000
SECUREONE_ENV=development

# Admin API calls use the signed-in operator's console session cookie (password + MFA).
