---
import Site from "../layouts/Site.astro";
---

<Site title="Page not found" description="This page does not exist.">
  <section class="hero" style="min-height:62vh">
    <div class="container" style="display:block;text-align:center">
      <span class="eyebrow">404</span>
      <h1 class="h1">This page does not exist</h1>
      <p class="lead" style="margin:20px auto 0">It may have moved when the documentation was organised into spaces.</p>
      <div class="hero-actions" style="justify-content:center">
        <a class="btn btn-primary" href="/">Home</a>
        <a class="btn btn-ghost" href="/docs/">Documentation</a>
      </div>
    </div>
  </section>
</Site>
