---
import Site from "../layouts/Site.astro";
import PageHead from "../components/PageHead.astro";
import Icon from "../components/Icon.astro";
// The repository's LICENSE is the single source of the licence text.
import licence from "../../../../LICENSE?raw";

const may = [
  "Run SecureOne for free, for any purpose, including commercially and in production",
  "Use it for sign-in to your own applications, including those you offer to your customers",
  "Make backups, replicas, test installations and copies of the image in your own registry",
  "Have employees and contractors operate it for you",
];
const mayNot = [
  "Sell, rent, sublicense or redistribute SecureOne or a modified version of it",
  "Offer SecureOne itself to others as a hosted or managed identity service",
  "Modify, decompile or reverse-engineer it, except where the law allows",
  "Remove copyright or licence notices",
];
---

<Site title="Licence" description="SecureOne is free to use, also commercially and in production, under the SecureOne End User Licence Agreement.">
  <PageHead eyebrow="Licence" title="Free to use, on your infrastructure" lead="SecureOne is licensed under the SecureOne End User Licence Agreement. In short: run it for free, for any purpose; do not resell it or offer it as a hosted service." />
  <section class="section section-soft">
    <div class="container">
      <div class="grid grid-2">
        <div class="card reveal">
          <div class="icon"><Icon name="shield" /></div>
          <h2 class="h3">You may</h2>
          <ul class="licence-list">{may.map((item) => <li>{item}</li>)}</ul>
        </div>
        <div class="card reveal">
          <div class="icon"><Icon name="lock" /></div>
          <h2 class="h3">You may not</h2>
          <ul class="licence-list">{mayNot.map((item) => <li>{item}</li>)}</ul>
        </div>
      </div>
      <p class="muted reveal" style="margin-top:28px">This summary is for convenience; the full text below is what applies. Open-source components inside SecureOne keep their own licences.</p>
    </div>
  </section>
  <section class="section">
    <div class="container prose reveal">
      <h2>Full text</h2>
      <pre class="licence-text">{licence}</pre>
    </div>
  </section>
</Site>

<style>
  .licence-list {
    margin: 12px 0 0;
    padding-left: 20px;
  }
  .licence-list li {
    margin: 8px 0;
  }
  .licence-text {
    white-space: pre-wrap;
    font-family: inherit;
    font-size: 15px;
    line-height: 1.6;
    padding: 24px;
    border-radius: 12px;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    overflow-wrap: anywhere;
  }
</style>
