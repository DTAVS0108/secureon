---
import "../styles/site.css";
import Icon from "../components/Icon.astro";

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const path = Astro.url.pathname;
const pageTitle = title === "SecureOne" ? "SecureOne · Identity and access for every app" : `${title} · SecureOne`;
const canonical = new URL(path, Astro.site).href;
const og = new URL("/og.png", Astro.site).href;

const nav = [
  { href: "/features/", label: "Features" },
  { href: "/security/", label: "Security" },
  { href: "/how-it-works/", label: "How it works" },
  { href: "/deploy/", label: "Deploy" },
  { href: "/docs/", label: "Docs" },
  { href: "/support/", label: "Support" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#4f46e5" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline>
      // Theme before first paint. Same key as the documentation pages, so the choice carries over.
      (() => {
        let choice = "";
        try {
          choice = localStorage.getItem("starlight-theme") || "";
        } catch {}
        const root = document.documentElement;
        root.classList.add("js");
        root.dataset.themeChoice = choice || "system";
        if (choice === "light" || choice === "dark") root.dataset.theme = choice;
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header" data-open="false">
      <div class="container">
        <a href="/" class="brand" aria-label="SecureOne home">
          <img src="/favicon.svg" alt="" width="32" height="32" />
          SecureOne
        </a>
        <nav class="nav" aria-label="Main">
          {nav.map((item) => (
            <a href={item.href} aria-current={path.startsWith(item.href) ? "page" : undefined}>{item.label}</a>
          ))}
          <a class="nav-extra" href="/docs/install/installation/">Install</a>
          <a class="nav-extra" href="/get-started/">Get started</a>
        </nav>
        <div class="header-cta">
          <a class="btn btn-ghost btn-sm" href="/docs/install/installation/">Install</a>
          <a class="btn btn-primary btn-sm" href="/get-started/">Get started</a>
        </div>
        <button class="theme-btn" type="button" aria-label="Theme: system" title="Theme">
          <span data-icon="system"><Icon name="monitor" /></span>
          <span data-icon="light"><Icon name="sun" /></span>
          <span data-icon="dark"><Icon name="moon" /></span>
        </button>
        <button class="menu-btn" type="button" aria-label="Menu" aria-expanded="false">Menu</button>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div>
            <a href="/" class="brand"><img src="/favicon.svg" alt="" width="32" height="32" />SecureOne</a>
            <p class="muted" style="max-width:320px;margin-top:14px;font-size:15px">
              Sign-in, single sign-on, MFA, users, roles and permissions for all your applications, from one place.
            </p>
          </div>
          <div>
            <h4>Product</h4>
            <ul>
              <li><a href="/features/">Features</a></li>
              <li><a href="/security/">Security</a></li>
              <li><a href="/how-it-works/">How it works</a></li>
              <li><a href="/deploy/">Deploy</a></li>
              <li><a href="/integrations/">Integrations</a></li>
              <li><a href="/releases/">Releases</a></li>
            </ul>
          </div>
          <div>
            <h4>Documentation</h4>
            <ul>
              <li><a href="/get-started/">Get started</a></li>
              <li><a href="/docs/install/installation/">Installation</a></li>
              <li><a href="/docs/integrate/integration-guide/">Connect an application</a></li>
              <li><a href="/docs/guide/">Admin console guide</a></li>
              <li><a href="/docs/install/runbooks/">Runbooks</a></li>
              <li><a href="/docs/api/">API reference</a></li>
            </ul>
          </div>
          <div>
            <h4>Company</h4>
            <ul>
              <li><a href="/about/">About</a></li>
              <li><a href="/faq/">FAQ</a></li>
              <li><a href="/support/">Support</a></li>
            </ul>
          </div>
        </div>
        <div class="footer-bottom">
          <span>© {new Date().getFullYear()} SecureOne</span>
          <span>OAuth 2.1 · OpenID Connect · SAML 2.0 · SCIM 2.0</span>
        </div>
      </div>
    </footer>

    <script>
      const header = document.querySelector(".site-header");
      const button = header?.querySelector(".menu-btn");
      const themeButton = document.querySelector(".theme-btn");
      const order = ["system", "light", "dark"];
      themeButton?.setAttribute("aria-label", `Theme: ${document.documentElement.dataset.themeChoice}`);
      themeButton?.addEventListener("click", () => {
        const root = document.documentElement;
        const next = order[(order.indexOf(root.dataset.themeChoice ?? "system") + 1) % order.length];
        root.dataset.themeChoice = next;
        if (next === "system") delete root.dataset.theme;
        else root.dataset.theme = next;
        themeButton.setAttribute("aria-label", `Theme: ${next}`);
        try {
          localStorage.setItem("starlight-theme", next === "system" ? "" : next);
        } catch {}
      });
      button?.addEventListener("click", () => {
        const open = header?.getAttribute("data-open") !== "true";
        header?.setAttribute("data-open", String(open));
        button.setAttribute("aria-expanded", String(open));
      });
      const observer = new IntersectionObserver(
        (entries) =>
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add("visible");
              observer.unobserve(e.target);
            }
          }),
        { threshold: 0.08, rootMargin: "0px 0px -40px 0px" },
      );
      document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
